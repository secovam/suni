# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=if(forEnv(development), suni-local-development-secret-not-for-production)

# @type=url
BETTER_AUTH_URL=if(forEnv(development), https://api.suni.localhost)

# @type=url
CORS_ORIGIN=if(forEnv(development), https://suni.localhost)

# @type=string(matches=regex("^postgres(ql)?://[^:]+:.+@[^/]+/.+$"))
DATABASE_URL=if(forEnv(development), postgresql://postgres:password@localhost:5432/suni)

# @public @type=url
VITE_SERVER_URL=if(forEnv(development), https://api.suni.localhost)

# Sender for outgoing emails, e.g. "Suni <no-reply@example.com>"
# @public
SMTP_FROM=if(forEnv(development), "Suni <no-reply@suni.localhost>")

# Mailpit in development (docker-compose.dev.yml)
# @public
SMTP_HOST=if(forEnv(development), localhost)

# @public @type=port
SMTP_PORT=if(forEnv(development), 1025, 587)

# @public @type=boolean
SMTP_SECURE=false

# @optional
SMTP_USER=

# @optional
SMTP_PASS=

# Logo shown in the magic link email
# @public @optional @type=url
LOGO_URL=

# @required @type=email
ADMIN_EMAIL=if(forEnv(development), "suni@localhost.com")

# @required
ADMIN_NAME=if(forEnv(development), "Suni")

# @public @type=url
VITE_SEPOMEX_URL=https://sepomex.secovam.com.mx
# S3-compatible file storage. Garage in development (docker-compose.dev.yml), Cloudflare R2 in production.
# Nothing reads these yet, so they are optional until the first module that stores files.
# @public @optional @type=url
STORAGE_ENDPOINT=if(forEnv(development), http://localhost:3900)

# R2 requires "auto"
# @public @optional
STORAGE_REGION=if(forEnv(development), garage)

# @optional
STORAGE_ACCESS_KEY_ID=if(forEnv(development), GKa5d1a3c0e4b27f6d8c1b9e02)

# @optional
STORAGE_SECRET_ACCESS_KEY=if(forEnv(development), 110d205bc858262b88c1880d3885f979fa084aaccf1d53a9c844875e567760a8)

# @public @optional
STORAGE_BUCKET_NAME=if(forEnv(development), suni-files)

# Base URL for reading files from the browser. It never includes the bucket.
# @public @optional @type=url
STORAGE_PUBLIC_URL=if(forEnv(development), http://suni-files.web.garage.localhost:3902)

# true for Garage (path-style), false for R2 (virtual-host)
# @public @optional @type=boolean
STORAGE_FORCE_PATH_STYLE=if(forEnv(development), true, false)
